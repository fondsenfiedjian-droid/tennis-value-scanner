{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fondsenfiedjian-droid/tennis-value-scanner/blob/research/tvs-research-lab-v1/research-lab/contracts/system-output.schema.json",
  "title": "TVS Research Lab SAS Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "system_id",
    "model_version_id",
    "status",
    "prediction_created_at",
    "data_cutoff_at",
    "reliability",
    "coverage",
    "evidence",
    "missing_fields"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "enum": [
        "PFE",
        "ACE",
        "SMA",
        "HFA"
      ]
    },
    "model_version_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "available",
        "insufficient_data",
        "abstain",
        "error"
      ]
    },
    "prediction_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "probability_a": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "probability_b": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "signal": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "signal_a": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "signal_b": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "reliability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "value",
          "source",
          "source_timestamp",
          "available_at"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_timestamp": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "probability_a",
              "probability_b"
            ]
          },
          {
            "required": [
              "signal"
            ]
          },
          {
            "required": [
              "signal_a"
            ]
          },
          {
            "required": [
              "signal_b"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "probability_a",
          "probability_b"
        ],
        "properties": {
          "probability_a": {
            "type": "number"
          },
          "probability_b": {
            "type": "number"
          }
        }
      },
      "then": {
        "properties": {
          "probability_a": {
            "type": "number"
          },
          "probability_b": {
            "type": "number"
          }
        }
      }
    }
  ]
}
